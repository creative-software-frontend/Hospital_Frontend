# Server
PORT=5000
NODE_ENV=development

# Database (MySQL / MariaDB)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/hospital_management"

# Security
JWT_SECRET="CHANGE_THIS_IN_PRODUCTION"
JWT_EXPIRES_IN="1d"
BCRYPT_SALT_ROUNDS=10
# JWT cookie name and options
JWT_COOKIE_NAME="hms_token"
COOKIE_SECURE="false"
# lax | strict | none
COOKIE_SAME_SITE="lax"
# optional: set only if cookies must be scoped to a specific domain
COOKIE_DOMAIN=""

# Seed (development bootstrap admin — NOT for production)
SEED_ADMIN_EMAIL="admin@hospital.com"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# CORS
CORS_ORIGIN="http://localhost:3000"
