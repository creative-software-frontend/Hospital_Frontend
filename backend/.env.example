# Copy this file to .env and replace the placeholder values before running
# `npm run setup`. The setup command refuses to continue while any placeholder
# below is still in place.

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL / MariaDB)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# `npm run setup` creates the database if the server does not have it yet, so it
# only has to exist as a name, not as an empty schema.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/hospital_management"

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_THIS_IN_PRODUCTION"
JWT_EXPIRES_IN="1d"
BCRYPT_SALT_ROUNDS=10
# JWT cookie name and options
JWT_COOKIE_NAME="hms_token"
COOKIE_SECURE="false"
# lax | strict | none
COOKIE_SAME_SITE="lax"
# optional: set only if cookies must be scoped to a specific domain
COOKIE_DOMAIN=""

# Seed (development demo logins — NOT for production)
# The seed creates one login per role, all sharing SEED_DEMO_PASSWORD, so every
# dashboard can be tried immediately (and the login page's Quick demo access
# buttons work). Recreate/refresh them any time with `npm run seed:demo`.
SEED_ADMIN_EMAIL="admin@hospital.com"
SEED_ADMIN_USERNAME="admin"
SEED_DEMO_PASSWORD="12345678"
# The branch the seed creates. Every other branch must be added in the UI, and
# the address dataset is copied into each one.
SEED_BRANCH_NAME="Main Branch"
SEED_BRANCH_CODE="MAIN"
# The seed refuses to run when NODE_ENV=production unless this is "true".
SEED_ALLOW_PRODUCTION="false"

# Local development only
# Where the Next.js public/ folder is looked up when someone uses "Open folder"
# on an asset path. Leave empty to use <repo root>/public.
PUBLIC_ASSETS_PATH=""

# Backups (Settings -> Backup)
# Where .sql dumps are written, and the mysqldump binary used to create them.
# MYSQLDUMP_PATH accepts a bare command name (resolved from PATH) or a full path.
# XAMPP example: MYSQLDUMP_PATH="C:\\xampp\\mysql\\bin\\mysqldump.exe"
BACKUP_STORAGE_PATH="./backups"
MYSQLDUMP_PATH="mysqldump"
# Set to "false" to stop the in-process automatic backup scheduler.
BACKUP_SCHEDULER_ENABLED="true"

# CORS
# The Next.js dev server proxies /api, so the browser stays same-origin and this
# only matters for direct API clients.
CORS_ORIGIN="http://localhost:3000"
