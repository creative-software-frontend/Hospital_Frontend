// prisma/schema.prisma
// HMS (Hospital Management System) database schema
// Based on the technical database specification, version 1.0.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 1. CORE SYSTEM
// ============================================================

model Branch {
  id              Int      @id @default(autoincrement())
  name            String
  code            String   @unique
  registrationNo  String?
  address         String?
  city            String?
  district        String?
  country         String?
  phone           String?
  email           String?
  logo            String?
  timezone        String?
  currency        String?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  departments     Department[]
  doctors         Doctor[]
  patients        Patient[]
  services        Service[]
  appointments    Appointment[]
  invoices        Invoice[]
  settings        SystemSetting[]
  warehouses      Warehouse[]
  integrations    Integration[]
  medicines       Medicine[]

  @@index([code])
}

model User {
  id           Int       @id @default(autoincrement())
  branchId     Int?
  name         String
  email        String    @unique
  phone        String?
  username     String    @unique
  password     String
  status       String    @default("active")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branch       Branch?   @relation(fields: [branchId], references: [id])
  userRoles    UserRole[]
  auditLogs    AuditLog[]
  doctor       Doctor?
  employee     Employee?

  @@index([username])
  @@index([email])
  @@index([branchId])
}

model Role {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  description   String?
  status        String          @default("active")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  rolePermissions RolePermission[]
  userRoles        UserRole[]

  @@index([name])
}

model Permission {
  id          Int            @id @default(autoincrement())
  module      String
  action      String
  description String?
  createdAt   DateTime       @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  branchId   Int?
  module     String
  action     String
  tableName  String?
  recordId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

// ============================================================
// 2. GENERAL SETTINGS
// ============================================================

model SystemSetting {
  id            Int      @id @default(autoincrement())
  branchId      Int?
  settingGroup  String
  settingKey    String
  settingValue  String?
  dataType      String?
  isEncrypted   Boolean  @default(false)
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([branchId, settingGroup, settingKey])
}

// ============================================================
// 3. BRANCH SETTINGS  -> branches table (see above)
// ============================================================

// ============================================================
// 5. SECURITY SETTINGS
// ============================================================

model SecuritySetting {
  id                      Int      @id @default(autoincrement())
  passwordMinLength       Int      @default(8)
  passwordExpiryDays      Int      @default(90)
  maxLoginAttempts        Int      @default(5)
  sessionTimeout          Int      @default(30)
  twoFactorEnabled        Boolean  @default(false)
  ipRestrictionEnabled    Boolean  @default(false)
  deviceRestrictionEnabled Boolean @default(false)
  auditLogEnabled         Boolean  @default(true)
  status                  String   @default("active")
  updatedAt               DateTime @updatedAt
}

// ============================================================
// 6. HOSPITAL CONFIGURATION
// ============================================================

model Department {
  id             Int      @id @default(autoincrement())
  branchId       Int?
  name           String
  code           String
  description    String?
  departmentType String?
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch   Branch?   @relation(fields: [branchId], references: [id])
  doctors  Doctor[]
  services Service[]
  employees Employee[]
  designations Designation[]

  @@unique([branchId, code])
  @@index([branchId])
}

// ============================================================
// 7. DOCTOR SETTINGS
// ============================================================

model Doctor {
  id              Int      @id @default(autoincrement())
  userId          Int?
  branchId        Int?
  departmentId    Int?
  doctorCode      String   @unique
  name            String
  specialization  String?
  qualification   String?
  registrationNo  String?
  phone           String?
  email           String?
  consultationFee Decimal? @db.Decimal(12, 2)
  followupFee     Decimal? @db.Decimal(12, 2)
  emergencyFee    Decimal? @db.Decimal(12, 2)
  commissionType  String?
  commissionValue Decimal? @db.Decimal(12, 2)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User?            @relation(fields: [userId], references: [id])
  branch     Branch?          @relation(fields: [branchId], references: [id])
  department Department?      @relation(fields: [departmentId], references: [id])
  schedules  DoctorSchedule[]
  appointments Appointment[]

  @@unique([userId])
  @@index([doctorCode])
  @@index([registrationNo])
  @@index([branchId])
}

model DoctorSchedule {
  id               Int      @id @default(autoincrement())
  doctorId         Int
  branchId         Int?
  dayOfWeek        Int
  startTime        String?
  endTime          String?
  roomId           Int?
  appointmentLimit Int      @default(0)
  status           String   @default("active")

  doctor Doctor @relation(fields: [doctorId], references: [id])
}

// ============================================================
// 8. PATIENT SETTINGS
// ============================================================

model Patient {
  id           Int      @id @default(autoincrement())
  branchId     Int?
  patientCode  String   @unique
  firstName    String
  lastName     String?
  gender       String?
  dateOfBirth  DateTime?
  bloodGroup   String?
  phone        String?
  email        String?
  address      String?
  district     String?
  nationalId   String?
  occupation   String?
  maritalStatus String?
  photo        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch       Branch?        @relation(fields: [branchId], references: [id])
  contacts     PatientContact[]
  appointments Appointment[]
  invoices     Invoice[]

  @@index([patientCode])
  @@index([phone])
  @@index([branchId])
}

model PatientContact {
  id           Int     @id @default(autoincrement())
  patientId    Int
  name         String
  relationship String?
  phone        String?
  address      String?
  isPrimary    Boolean @default(false)

  patient Patient @relation(fields: [patientId], references: [id])
}

// ============================================================
// 9. SERVICE SETTINGS
// ============================================================

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String   @default("active")

  services Service[]
}

model Service {
  id             Int      @id @default(autoincrement())
  branchId       Int?
  departmentId   Int?
  categoryId     Int?
  serviceCode    String   @unique
  name           String
  description    String?
  price          Decimal? @db.Decimal(12, 2)
  taxPercent     Decimal? @db.Decimal(5, 2)
  discountAllowed Boolean  @default(true)
  status         String   @default("active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch       Branch?          @relation(fields: [branchId], references: [id])
  department   Department?      @relation(fields: [departmentId], references: [id])
  category     ServiceCategory? @relation(fields: [categoryId], references: [id])

  @@index([serviceCode])
  @@index([branchId])
}

// ============================================================
// 10. OPD SETTINGS
// ============================================================

model OpdSetting {
  id                   Int      @id @default(autoincrement())
  branchId             Int?
  registrationFee      Decimal? @db.Decimal(12, 2)
  consultationFee      Decimal? @db.Decimal(12, 2)
  followupDays         Int      @default(14)
  appointmentDuration  Int      @default(15)
  queueEnabled         Boolean  @default(true)
  prescriptionEnabled  Boolean  @default(true)
  status               String   @default("active")
}

// ============================================================
// 11. IPD SETTINGS
// ============================================================

model IpdSetting {
  id            Int      @id @default(autoincrement())
  branchId      Int?
  admissionFee  Decimal? @db.Decimal(12, 2)
  dischargeFee  Decimal? @db.Decimal(12, 2)
  bedCharge     Decimal? @db.Decimal(12, 2)
  nursingCharge Decimal? @db.Decimal(12, 2)
  serviceCharge Decimal? @db.Decimal(12, 2)
  status        String   @default("active")
}

// ============================================================
// 12. EMERGENCY SETTINGS
// ============================================================

model EmergencySetting {
  id               Int      @id @default(autoincrement())
  branchId         Int?
  registrationFee  Decimal? @db.Decimal(12, 2)
  consultationFee  Decimal? @db.Decimal(12, 2)
  serviceCharge    Decimal? @db.Decimal(12, 2)
  triageEnabled    Boolean  @default(true)
  status           String   @default("active")
}

// ============================================================
// 13. PRESCRIPTION SETTINGS
// ============================================================

model PrescriptionTemplate {
  id           Int      @id @default(autoincrement())
  branchId     Int?
  name         String
  header       String?
  footer       String?
  logo         String?
  signature    String?
  templateData Json?
  status       String   @default("active")

  prescriptions PrescriptionSetting[]

  @@unique([branchId, name])
}

model PrescriptionSetting {
  id                 Int      @id @default(autoincrement())
  branchId           Int?
  templateId         Int?
  showPatientHistory Boolean  @default(true)
  showDiagnosis      Boolean  @default(true)
  showMedicine       Boolean  @default(true)
  showDosage         Boolean  @default(true)
  showInstruction    Boolean  @default(true)
  showDoctorSignature Boolean @default(true)
  showQrCode         Boolean  @default(false)
  status             String   @default("active")

  template PrescriptionTemplate? @relation(fields: [templateId], references: [id])
}

// ============================================================
// 14. DIAGNOSIS SETTINGS
// ============================================================

model DiagnosisCategory {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  status      String     @default("active")

  diagnoses Diagnosis[]
}

model Diagnosis {
  id          Int      @id @default(autoincrement())
  categoryId  Int?
  code        String   @unique
  name        String
  description String?
  status      String   @default("active")

  category DiagnosisCategory? @relation(fields: [categoryId], references: [id])
}

// ============================================================
// 15. PHARMACY SETTINGS
// ============================================================

model MedicineCategory {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  status      String     @default("active")

  medicines Medicine[]
}

model MedicineUnit {
  id        Int      @id @default(autoincrement())
  name      String
  shortName String
  status    String   @default("active")

  medicines     Medicine[]
  inventoryItems InventoryItem[]
}

model Medicine {
  id            Int      @id @default(autoincrement())
  branchId      Int?
  categoryId    Int?
  unitId        Int?
  genericName   String
  brandName     String?
  medicineCode  String   @unique
  barcode       String?
  manufacturer  String?
  reorderLevel  Int      @default(10)
  status        String   @default("active")

  branch     Branch?         @relation(fields: [branchId], references: [id])
  category   MedicineCategory? @relation(fields: [categoryId], references: [id])
  unit       MedicineUnit?   @relation(fields: [unitId], references: [id])
  batches    MedicineBatch[]

  @@index([medicineCode])
  @@index([barcode])
}

model MedicineBatch {
  id           Int      @id @default(autoincrement())
  medicineId   Int
  batchNo      String
  purchasePrice Decimal? @db.Decimal(12, 2)
  sellingPrice Decimal?  @db.Decimal(12, 2)
  quantity     Int      @default(0)
  expiryDate   DateTime?
  status       String   @default("active")

  medicine Medicine @relation(fields: [medicineId], references: [id])
}

model PharmacySetting {
  id              Int     @id @default(autoincrement())
  branchId        Int?
  taxPercent      Decimal? @db.Decimal(5, 2)
  defaultDiscount Decimal? @db.Decimal(5, 2)
  expiryAlertDays Int     @default(30)
  lowStockAlert   Boolean @default(true)
  barcodeEnabled  Boolean @default(true)
  batchEnabled    Boolean @default(true)
  status          String  @default("active")
}

// ============================================================
// 16. LABORATORY SETTINGS
// ============================================================

model LabCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  status      String   @default("active")

  labTests LabTest[]
}

model LabTest {
  id             Int      @id @default(autoincrement())
  categoryId     Int?
  testCode       String   @unique
  testName       String
  sampleType     String?
  price          Decimal? @db.Decimal(12, 2)
  turnaroundTime Int?
  status         String   @default("active")

  category   LabCategory?       @relation(fields: [categoryId], references: [id])
  parameters LabTestParameter[]

  @@index([testCode])
}

model LabTestParameter {
  id               Int     @id @default(autoincrement())
  testId           Int
  parameterName    String
  unit             String?
  normalRangeMale  String?
  normalRangeFemale String?
  normalRangeChild String?
  criticalLow      String?
  criticalHigh     String?

  test LabTest @relation(fields: [testId], references: [id])
}

model LabSetting {
  id                      Int     @id @default(autoincrement())
  branchId                Int?
  sampleTrackingEnabled   Boolean @default(true)
  barcodeEnabled          Boolean @default(true)
  onlineReportEnabled     Boolean @default(true)
  reportApprovalRequired  Boolean @default(false)
  defaultReportTemplate   String?
  status                  String  @default("active")
}

// ============================================================
// 17. BILLING SETTINGS
// ============================================================

model PaymentMethod {
  id     Int     @id @default(autoincrement())
  name   String
  code   String
  type   String?
  status String  @default("active")

  invoices Invoice[]
}

model BillingSetting {
  id                   Int     @id @default(autoincrement())
  branchId             Int?
  invoicePrefix        String  @default("INV-")
  invoiceStartNumber   Int     @default(1)
  receiptPrefix        String  @default("RCT-")
  taxPercent           Decimal? @db.Decimal(5, 2)
  serviceChargePercent Decimal? @db.Decimal(5, 2)
  discountEnabled      Boolean @default(true)
  partialPaymentEnabled Boolean @default(true)
  refundEnabled        Boolean @default(true)
  duePaymentEnabled    Boolean @default(true)
  status               String  @default("active")
}

model Invoice {
  id           Int      @id @default(autoincrement())
  branchId     Int?
  patientId    Int?
  invoiceNumber String  @unique
  paymentMethodId Int?
  subtotal     Decimal? @db.Decimal(12, 2)
  taxAmount    Decimal? @db.Decimal(12, 2)
  discountAmount Decimal? @db.Decimal(12, 2)
  total        Decimal? @db.Decimal(12, 2)
  status       String   @default("pending")
  issuedAt     DateTime @default(now())

  branch       Branch?       @relation(fields: [branchId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  @@index([invoiceNumber])
  @@index([patientId])
  @@index([branchId])
}

// ============================================================
// 18. ACCOUNTING SETTINGS
// ============================================================

model AccountCategory {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  description String?
  status      String   @default("active")

  accounts Account[]
}

model Account {
  id             Int      @id @default(autoincrement())
  branchId       Int?
  categoryId     Int?
  accountCode    String   @unique
  accountName    String
  openingBalance Decimal? @db.Decimal(14, 2)
  currentBalance Decimal? @db.Decimal(14, 2)
  status         String   @default("active")

  category AccountCategory? @relation(fields: [categoryId], references: [id])
}

model IncomeCategory {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  status      String  @default("active")
}

model ExpenseCategory {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  status      String  @default("active")
}

// ============================================================
// 19. HR & PAYROLL SETTINGS
// ============================================================

model EmployeeType {
  id     Int     @id @default(autoincrement())
  name   String
  status String  @default("active")

  employees Employee[]
}

model Designation {
  id           Int      @id @default(autoincrement())
  name         String
  departmentId Int?
  status       String   @default("active")

  department Department? @relation(fields: [departmentId], references: [id])
  employees  Employee[]
}

model SalaryComponent {
  id              Int     @id @default(autoincrement())
  name            String
  componentType   String
  calculationType String?
  value           Decimal? @db.Decimal(12, 2)
  status          String  @default("active")
}

model LeaveType {
  id          Int     @id @default(autoincrement())
  name        String
  daysAllowed Int     @default(0)
  paid        Boolean @default(true)
  status      String  @default("active")
}

model ShiftType {
  id           Int     @id @default(autoincrement())
  name         String
  startTime    String?
  endTime      String?
  graceMinutes Int     @default(0)
  status       String  @default("active")
}

model Employee {
  id            Int      @id @default(autoincrement())
  userId        Int?     @unique
  branchId      Int?
  employeeTypeId Int?
  designationId Int?
  departmentId  Int?
  name          String
  employeeCode  String   @unique
  phone         String?
  email         String?
  hireDate      DateTime?
  basicSalary   Decimal? @db.Decimal(12, 2)
  status        String   @default("active")
  createdAt     DateTime @default(now())

  user         User?          @relation(fields: [userId], references: [id])
  employeeType EmployeeType?  @relation(fields: [employeeTypeId], references: [id])
  designation  Designation?   @relation(fields: [designationId], references: [id])
  department   Department?    @relation(fields: [departmentId], references: [id])
}

// ============================================================
// 20. INVENTORY SETTINGS
// ============================================================

model InventoryCategory {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  status      String     @default("active")

  items InventoryItem[]
}

model Warehouse {
  id        Int     @id @default(autoincrement())
  branchId  Int?
  name      String
  code      String
  location  String?
  managerId Int?
  status    String  @default("active")

  branch Branch? @relation(fields: [branchId], references: [id])
  stock  InventoryStock[]
}

model InventoryItem {
  id           Int      @id @default(autoincrement())
  categoryId   Int?
  unitId       Int?
  itemCode     String   @unique
  name         String
  reorderLevel Int      @default(10)
  status       String   @default("active")

  category InventoryCategory? @relation(fields: [categoryId], references: [id])
  unit     MedicineUnit?      @relation(fields: [unitId], references: [id])
  stock    InventoryStock[]
}

model InventoryStock {
  id           Int      @id @default(autoincrement())
  warehouseId  Int
  itemId       Int
  quantity     Int      @default(0)
  averageCost  Decimal? @db.Decimal(14, 2)
  lastUpdated  DateTime @updatedAt

  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  item      InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([warehouseId, itemId])
}

// ============================================================
// 21. NOTIFICATION SETTINGS
// ============================================================

model NotificationSetting {
  id                     Int     @id @default(autoincrement())
  branchId               Int?
  smsEnabled             Boolean @default(false)
  emailEnabled           Boolean @default(false)
  whatsappEnabled        Boolean @default(false)
  appointmentNotification Boolean @default(true)
  billingNotification    Boolean @default(true)
  labNotification        Boolean @default(true)
  followupNotification   Boolean @default(true)
  paymentNotification    Boolean @default(true)
  status                 String  @default("active")
}

model SmsGateway {
  id       Int     @id @default(autoincrement())
  name     String
  apiUrl   String?
  apiKey   String?
  senderId String?
  status   String  @default("active")
}

model EmailSetting {
  id        Int     @id @default(autoincrement())
  smtpHost  String?
  smtpPort  Int?
  username  String?
  password  String?
  encryption String?
  fromName  String?
  fromEmail String?
  status    String  @default("active")
}

// ============================================================
// 22. PRINT & DOCUMENT SETTINGS
// ============================================================

model DocumentTemplate {
  id              Int     @id @default(autoincrement())
  branchId        Int?
  documentType    String
  templateName    String
  header          String?
  footer          String?
  logo            String?
  signature       String?
  templateContent String?
  status          String  @default("active")

  reportSettings ReportSetting[]

  @@unique([branchId, documentType, templateName])
}

// ============================================================
// 23. API & INTEGRATION SETTINGS
// ============================================================

model Integration {
  id              Int     @id @default(autoincrement())
  branchId        Int?
  integrationType String
  providerName    String
  apiUrl          String?
  apiKey          String?
  secretKey       String?
  configuration   Json?
  status          String  @default("active")

  branch Branch? @relation(fields: [branchId], references: [id])
}

// ============================================================
// 24. BACKUP & DATABASE SETTINGS
// ============================================================

model BackupSetting {
  id                Int     @id @default(autoincrement())
  backupType        String
  frequency         String?
  storageType       String?
  storagePath       String?
  retentionDays     Int     @default(30)
  encryptionEnabled Boolean @default(true)
  status            String  @default("active")
}

model BackupLog {
  id              Int      @id @default(autoincrement())
  backupType      String
  fileName        String?
  fileSize        Int?
  storageLocation String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  status          String   @default("running")
  errorMessage    String?
}

// ============================================================
// 25. REPORT SETTINGS
// ============================================================

model ReportSetting {
  id          Int     @id @default(autoincrement())
  branchId    Int?
  reportName  String
  reportType  String
  templateId  Int?
  showLogo    Boolean @default(true)
  showHeader  Boolean @default(true)
  showFooter  Boolean @default(true)
  showSignature Boolean @default(true)
  exportPdf   Boolean @default(true)
  exportExcel Boolean @default(true)
  status      String  @default("active")

  template DocumentTemplate? @relation(fields: [templateId], references: [id])
}

// ============================================================
// 26. LOCALIZATION SETTINGS
// ============================================================

model LocalizationSetting {
  id            Int     @id @default(autoincrement())
  branchId      Int?
  language      String  @default("English")
  currency      String  @default("BDT")
  currencySymbol String @default("৳")
  dateFormat    String  @default("DD-MM-YYYY")
  timeFormat    String  @default("24h")
  timezone      String  @default("Asia/Dhaka")
  numberFormat  String?
  weekStartDay  Int     @default(1)

  @@unique([branchId, language])
}

// ============================================================
// 28. SYSTEM MAINTENANCE
// ============================================================

model SystemMaintenance {
  id               Int      @id @default(autoincrement())
  maintenanceMode  Boolean  @default(false)
  cacheEnabled     Boolean  @default(true)
  lastCacheClear   DateTime?
  systemVersion    String?
  lastUpdate       DateTime?
  databaseOptimization DateTime?
  status           String   @default("active")
}

// ============================================================
// APPENDED / DOMAIN TABLES (referenced by the data flow)
// ============================================================

model Appointment {
  id              Int      @id @default(autoincrement())
  branchId        Int?
  patientId       Int?
  doctorId        Int?
  appointmentDate DateTime?
  status          String   @default("pending")
  notes           String?
  createdAt       DateTime @default(now())

  patient Patient? @relation(fields: [patientId], references: [id])
  doctor  Doctor?  @relation(fields: [doctorId], references: [id])
  branch  Branch?  @relation(fields: [branchId], references: [id])

  @@index([doctorId])
  @@index([patientId])
  @@index([appointmentDate])
}

