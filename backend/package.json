{
    "name": "hospital-backend",
    "version": "1.0.0",
    "private": true,
    "description": "REST API backend for the Hospital Management System (HMS)",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "eslint \"src/**/*.ts\"",
        "test": "vitest run",
        "db:setup": "tsx prisma/setup.ts",
        "db:create": "tsx prisma/create-database.ts",
        "db:migrate": "prisma migrate deploy",
        "db:migrate:dev": "prisma migrate dev",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio",
        "prisma:generate": "prisma generate",
        "seed:address": "tsx prisma/seed-address.ts",
        "seed:demo": "tsx prisma/seedDemo.ts",
        "seed:address:sql": "tsx prisma/generateAddressSql.ts"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "bcryptjs": "^2.4.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/morgan": "^1.9.9",
        "@types/node": "^20.17.9",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "eslint": "^8.57.1",
        "prisma": "^5.22.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2",
        "vitest": "^4.1.11"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "allowScripts": {
        "@prisma/client@5.22.0": true,
        "@prisma/engines@5.22.0": true,
        "esbuild@0.21.5": true,
        "esbuild@0.28.2": true,
        "prisma@5.22.0": true
    }
}
